{
  "name": "buildops-platform",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "web": "pnpm --filter mobile web",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:users": "node scripts/create-dev-users.mjs",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "test": "pnpm --filter @buildops/shared test",
    "db:test": "supabase test db",
    "test:functions": "node scripts/test-admin-users.mjs"
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
