{
  "expo": {
    "name": "BuildOps",
    "slug": "buildops",
    "scheme": "buildops",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildops.app"
    },
    "android": {
      "package": "com.buildops.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O BuildOps usa a câmera para fotografar notas fiscais e materiais.",
          "photosPermission": "O BuildOps usa suas fotos para anexar notas fiscais e materiais.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
